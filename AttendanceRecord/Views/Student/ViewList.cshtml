@model List<AttendanceRecord.Models.Student>

<h2>List of Student</h2>
@foreach (var s in Model)
{
    <p>
        <strong>ID:</strong>@s.StudentId
    </p>

    <p>
        <strong>Name:</strong>@s.Name
    </p>

    <p>
        <strong>Email:</strong>@s.Email
    </p>


    <br />
    <hr />
}
<a href="/Student/Index">Back</a>
